{
  "expo": {
    "name": "Aki Ofertas",
    "slug": "aki-ofertas",
    "scheme": "akiofertas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.akiofertas.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.656464832303-uu6qd4l9im93htqfvilntb71hfdlb9ma"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.akiofertas.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aki Ofertas usa sua localização para mostrar ofertas perto de você.",
          "locationAlwaysAndWhenInUsePermission": "Aki Ofertas usa sua localização para mostrar ofertas perto de você."
        }
      ],
      "expo-image",
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e315b712-09dd-4d45-9eaf-9d72799f209d"
      }
    }
  }
}
