# Base URL of the Aki Ofertas mobile API. Defaults to production if unset.
EXPO_PUBLIC_API_URL=https://akiofertas.com.br

# Google Sign-In client IDs (from Google Cloud Console — not yet created for this app).
# Leave unset until a real Google Cloud project exists; the Google button
# is automatically disabled when these are missing.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
