# Postgres connection string from your Neon project (Neon dashboard > Connection Details).
# Consumed via prisma.config.ts (Prisma 7 reads the datasource URL there, NOT from schema.prisma).
DATABASE_URL="postgresql://user:password@host/aki_ofertas?sslmode=require"
# Secret used by Auth.js/NextAuth to sign sessions/tokens. Generate one with: npx auth secret
AUTH_SECRET="generate-with: npx auth secret"
# Vercel Blob read/write token for file uploads (Vercel dashboard > Storage > Blob).
BLOB_READ_WRITE_TOKEN=""
